# PrintPal configuration
# Copy this file to .env and fill in your values.
# Settings can also be managed at runtime with /config (stored in the database,
# and override .env values).

# --- Thingiverse (Level 1: search & download) ---
# Create an app at https://www.thingiverse.com/apps/create and copy its App Token.
THINGIVERSE_TOKEN=

# --- Cura / CuraEngine (Level 2: slicing) ---
# Auto-detected if Ultimaker Cura is installed. Set manually if auto-detection fails.
# PRINTMCP_CURA_DIR=C:\Program Files\UltiMaker Cura 5.11.0

# --- OctoPrint (Level 3: printing) ---
# Your OctoPrint server URL and API key.
# API key: OctoPrint > Settings > API, or a per-user Application Key.
# OCTOPRINT_URL=http://octopi.local
# OCTOPRINT_API_KEY=

# --- AI Model (optional — defaults to Claude Sonnet) ---
# Set ANTHROPIC_API_KEY for Claude, or other provider keys for LiteLLM models.
ANTHROPIC_API_KEY=